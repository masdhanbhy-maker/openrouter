TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather
# Comma-separated group chat IDs (send /id in the group to find it). Empty = any chat.
ALLOWED_CHAT_IDS=-1001234567890
# Optional: only accept files from these Telegram user IDs
ALLOWED_USER_IDS=
# Which documents to upload. Empty = no filter on that criterion.
ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx
FILENAME_KEYWORDS=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=/TelegramUploads
SUBFOLDER_PER_CHAT=true
CONFIRM_IN_CHAT=true
